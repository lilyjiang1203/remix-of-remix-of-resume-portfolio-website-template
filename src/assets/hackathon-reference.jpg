<!doctype html>
<html lang="en">
  <head>
    <script type="module">import { injectIntoGlobalHook } from "/@react-refresh";
injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;</script>

    <script type="module" src="/@vite/client"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Li Jiang — Full Stack Developer</title>
    <meta name="description" content="Li Jiang is a full stack developer based in Edmonton, Canada, blending design experience with modern software development." />
    <meta name="author" content="Li Jiang" />
    <meta name="keywords" content="full stack developer, software developer, portfolio, Li Jiang, Edmonton, web development, mobile development" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Li Jiang — Full Stack Developer" />
    <meta property="og:description" content="Portfolio of full stack development projects by Li Jiang, based in Edmonton, Canada." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Li Jiang — Full Stack Developer" />
    <meta name="twitter:description" content="Portfolio of full stack development projects by Li Jiang, based in Edmonton, Canada." />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://lijiang.design/" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@200;300;400;500&display=swap" rel="stylesheet">

    <!-- Preload critical assets -->
    <link rel="preload" href="/placeholder.svg" as="image" />
  </head>

  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
